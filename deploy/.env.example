# Copie para deploy/.env (não versionado) e ajuste.
#
# Hash SHA-256 (hex minúsculo) do segredo da credencial administrativa inicial.
# O segredo deve começar com "tradux_". Para gerar o hash no PowerShell:
#   $s = 'tradux_troque-este-segredo'; ([System.Security.Cryptography.SHA256]::HashData([Text.Encoding]::UTF8.GetBytes($s)) | ForEach-Object { $_.ToString('x2') }) -join ''
TRADUX_ADMIN_SECRET_SHA256=
TRADUX_ORGANIZATION=org-a

# Endereços vistos pelo navegador.
API_PUBLIC_URL=http://localhost:8080
EDITOR_ORIGIN=http://localhost:8081
