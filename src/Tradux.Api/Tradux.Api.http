@host = http://localhost:5220
@key = tradux_dev-admin-org-a
@template = dps-erp

### Contrato OpenAPI
GET {{host}}/openapi/v1.json

### Templates da organização da credencial
GET {{host}}/v1/templates
Authorization: ApiKey {{key}}

### Histórico de versões
GET {{host}}/v1/templates/{{template}}/versions
Authorization: ApiKey {{key}}

### Converter: XML de origem → XML de destino (versão ativa)
POST {{host}}/v1/templates/{{template}}/convert?correlationId=pedido-42
Authorization: ApiKey {{key}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<NotaErp xmlns="http://exemplo.ilustrativo.tradux/erp/v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" versao="2.1" situacao="1">
  <Identificacao><Numero>000123</Numero><Serie>A1</Serie><DataEmissao>2026-09-28</DataEmissao><Competencia>2026-09</Competencia></Identificacao>
  <Prestador><Cnpj>12345678000199</Cnpj><Nome>Prestadora Exemplo Ltda</Nome></Prestador>
  <Tomador><Cnpj>98765432000188</Cnpj></Tomador>
  <Servico><Codigo>01.02.03</Codigo><Discriminacao>Consultoria em sistemas</Discriminacao><Valor moeda="BRL">1500.50</Valor><Desconto xsi:nil="true"/></Servico>
</NotaErp>

### Reativar a versão 1
POST {{host}}/v1/templates/{{template}}/rollback
Authorization: ApiKey {{key}}
Content-Type: application/json

{ "version": 1 }
